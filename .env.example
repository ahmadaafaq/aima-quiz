# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# EmailJS — transactional email service (https://www.emailjs.com)
# SENDER: Sjames@aima.in (AIMA institutional email on Microsoft 365 / Outlook)
# Setup steps:
# 1. Sign up at emailjs.com
# 2. Add Service:
#    - Select "Outlook" (or "Custom SMTP" with host: smtp.office365.com, port: 587, user: Sjames@aima.in)
#    - Authenticate with Sjames@aima.in
# 3. Create 4 templates with sender Sjames@aima.in & name "All India Management Association (AIMA)"
# 4. Copy Public Key from Account -> API Keys
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
VITE_EMAILJS_TEMPLATE_REGISTRATION=""   # template for registration confirmation
VITE_EMAILJS_TEMPLATE_TEAM_MEMBER=""    # template for team member added
VITE_EMAILJS_TEMPLATE_R1_RESULTS=""     # template for Round 1 result notification
VITE_EMAILJS_TEMPLATE_FINAL_RESULTS=""  # template for final result + certificate link

# Optional custom sender overrides (defaults to Sjames@aima.in)
VITE_EMAIL_FROM="Sjames@aima.in"
VITE_EMAIL_FROM_NAME="All India Management Association (AIMA)"
VITE_EMAIL_REPLY_TO="Sjames@aima.in"
